{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "gitleaks stdin -v --no-color --no-banner --redact --exit-code 2 1>&2",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
