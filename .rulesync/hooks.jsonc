{
  // One hook, and it is one line of configuration. rulesync translates this
  // single declaration into each agent's native hook registration, so nothing
  // here is written into an agent's settings file by hand. Regenerate with
  // `npx rulesync generate`.
  //
  // The command is gitleaks itself, unwrapped. The agent host pipes the tool
  // call's JSON payload to the hook's stdin; gitleaks scans that raw JSON and
  // exits 2 on a finding, which is the one exit code the host reads as "stop,
  // do not run this tool call". The file content sits JSON-escaped inside the
  // payload, and gitleaks' rules match straight through the escaping — a
  // planted AWS key inside `content`, `new_string`, `new_source`, and
  // `edits[].new_string` each exited 2 when this line was verified on
  // 2026-08-23. Scanning the whole payload is what makes per-tool field
  // extraction unnecessary, and it is why this repository's previous 66-line
  // Node wrapper is deleted: the wrapper existed to pull those four fields
  // out, and it once shipped silently ignoring one of them (NotebookEdit's
  // new_source). A scan that never selects fields cannot repeat that bug.
  //
  // Flag by flag:
  //   stdin          scan standard input instead of a git repository
  //   -v             print each finding, so the refusal names the rule that
  //                  fired instead of a bare "leaks found: 1"
  //   --no-color     plain text for the agent transcript
  //   --no-banner    no startup banner
  //   --redact       findings name the rule, never the secret itself
  //                  (bare flag redacts 100 percent, its default)
  //   --exit-code 2  a finding exits 2 (the default 1 would not block)
  //   1>&2           findings print to stdout; the host shows the agent
  //                  stderr on a blocked call, so route them there
  //
  // What happens when gitleaks is not installed: the shell exits 127, the
  // host reads any exit other than 2 as "allow", and the write goes through
  // unscanned. That is a real trade, and it is taken with eyes open: the
  // commit gate in .trunk/trunk.yaml runs Trunk's own pinned gitleaks and
  // still refuses to let a secret into history, and tests/hooks.test.mjs
  // fails the suite when gitleaks is missing from PATH, so CI and
  // `npm run verify` both name the gap before it matters. The alternative was
  // a wrapper script that fails closed, and a wrapper script is owned code.
  //
  // One host is the known exception, and SPEC.md's Known gaps row carries it:
  // rulesync 16.14.0's generated OpenCode plugin runs this command WITHOUT
  // piping the tool payload into stdin, so on OpenCode the scan reads empty
  // input and exits 0 — the registration is decorative there until rulesync
  // fixes its OpenCode hook template, and a missing gitleaks makes that host
  // fail closed rather than open (its runner throws on any non-zero exit).
  // The commit gate is OpenCode's real secret gate meanwhile.
  //
  // Path-free on purpose: the command names no file in this repository, so a
  // fork never edits it. gitleaks installs are one line per platform:
  //   winget install Gitleaks.Gitleaks     (Windows)
  //   brew install gitleaks                (macOS)
  //   https://github.com/gitleaks/gitleaks/releases (Linux, single binary)
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        // Matches the file-writing tools only. Bash is left out deliberately:
        // scanning every shell command costs a gitleaks spawn per command, and
        // the commit-time gitleaks run under Trunk is the backstop for anything
        // a shell redirect writes.
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "type": "command",
        "timeout": 15,
        "command": "gitleaks stdin -v --no-color --no-banner --redact --exit-code 2 1>&2",
      },
      {
        // The native todo/plan tools, blocked. The plan lives in files
        // (planning-with-files, below); a built-in todo list is a second
        // half-plan that dies with the session. rulesync has no permission
        // key that can deny a named tool, so the deny is this hook: exit 2
        // refuses the call and the message points at the file plan. The
        // matcher carries each agent's own name for the tool, since every
        // CLI names it differently.
        "matcher": "TodoWrite|todowrite|todoread|todo_write|update_plan",
        "type": "command",
        "timeout": 5,
        "command": "echo 'This project plans in files, not in a todo tool: put the plan in task_plan.md and track progress there (planning-with-files skill).' 1>&2; exit 2",
      },
    ],

    // planning-with-files, gated. The skill (pinned in rulesync.jsonc)
    // declares these same hooks in its own SKILL.md frontmatter, and rulesync
    // strips that key when it publishes — so the skill installs on every
    // agent and fires nothing, invisibly. Declaring them here is what makes
    // the plan real: the sessionStart hook creates the first plan, the
    // prompt hook re-injects it each turn, and the Stop hook refuses to end
    // a turn while a phase is still in_progress (the gate returns a block
    // decision naming the unfinished phase). Every command is the vendor's
    // own script, resolved from wherever the skill is installed — this
    // repository's generated .claude/skills/ first, then the user-scope
    // installs — and each ends in `exit 0`, so a missing skill degrades to
    // silence rather than wedging a turn. The gate itself fails open on: no
    // plan directory, PLANNING_DISABLED=1, stop_hook_active, or 20 blocks in
    // one session, so it cannot trap a session indefinitely.
    "sessionStart": [
      {
        "type": "command",
        "timeout": 30,
        "command": "[ -n \"$PLANNING_DISABLED\" ] && exit 0; [ -d .planning ] && exit 0; SH=$(ls .claude/skills/planning-with-files/scripts/init-session.sh \"$HOME/.claude/skills/planning-with-files/scripts/init-session.sh\" \"$HOME/.agents/skills/planning-with-files/scripts/init-session.sh\" 2>/dev/null | head -1); [ -n \"$SH\" ] && sh \"$SH\" --gated plan >/dev/null 2>&1; exit 0",
      },
    ],

    // rulesync's canonical name for the UserPromptSubmit event; it translates
    // this spelling per target.
    "beforeSubmitPrompt": [
      {
        "type": "command",
        "timeout": 15,
        "command": "SH=$(ls .claude/skills/planning-with-files/scripts/inject-plan.sh \"$HOME/.claude/skills/planning-with-files/scripts/inject-plan.sh\" \"$HOME/.agents/skills/planning-with-files/scripts/inject-plan.sh\" 2>/dev/null | head -1); [ -n \"$SH\" ] && sh \"$SH\" --context=userprompt; exit 0",
      },
    ],

    "postToolUse": [
      {
        "matcher": "Write|Edit",
        "type": "command",
        "timeout": 10,
        "command": "if [ -f task_plan.md ] || [ -f .planning/.active_plan ] || ls .planning/*/task_plan.md >/dev/null 2>&1; then echo '[planning-with-files] Update progress.md with what you just did. If a phase is now complete, update task_plan.md status.'; fi",
      },
    ],

    "preCompact": [
      {
        "matcher": "*",
        "type": "command",
        "timeout": 15,
        "command": "SH=$(ls .claude/skills/planning-with-files/scripts/inject-plan.sh \"$HOME/.claude/skills/planning-with-files/scripts/inject-plan.sh\" \"$HOME/.agents/skills/planning-with-files/scripts/inject-plan.sh\" 2>/dev/null | head -1); [ -n \"$SH\" ] && sh \"$SH\" --context=precompact; exit 0",
      },
    ],

    "stop": [
      {
        "type": "command",
        "timeout": 20,
        "command": "SH=$(ls .claude/skills/planning-with-files/scripts/gate-stop.sh \"$HOME/.claude/skills/planning-with-files/scripts/gate-stop.sh\" \"$HOME/.agents/skills/planning-with-files/scripts/gate-stop.sh\" 2>/dev/null | head -1); [ -n \"$SH\" ] && sh \"$SH\" 2>/dev/null; exit 0",
      },
    ],
  },

  // Copilot and Cline register preToolUse hooks but have no matcher on them,
  // so rulesync drops the entry above for those two rather than silently
  // widening it. These override blocks put the same command back without a
  // matcher, which means it fires on every tool call there. That is cheap:
  // gitleaks reads whatever payload arrives and exits 0 in milliseconds when
  // it holds no secret, which is every ordinary tool call.
  "copilot": {
    "hooks": {
      "preToolUse": [
        { "type": "command", "timeout": 15, "command": "gitleaks stdin -v --no-color --no-banner --redact --exit-code 2 1>&2" },
      ],
    },
  },
  "cline": {
    "hooks": {
      "preToolUse": [
        { "type": "command", "timeout": 15, "command": "gitleaks stdin -v --no-color --no-banner --redact --exit-code 2 1>&2" },
      ],
    },
  },
}
