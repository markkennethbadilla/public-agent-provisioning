# Trunk caches and downloaded tools. Trunk restores all of it from
# .trunk/trunk.yaml, which is the only file in .trunk that is committed.
# No trailing slashes: `trunk git-hooks sync` creates most of these as symlinks
# into %LOCALAPPDATA%, and a trailing slash matches a directory but not a symlink.
.trunk/out
.trunk/actions
.trunk/logs
.trunk/notifications
.trunk/plugins
.trunk/tools

# Curated skill copies fetched by `npx rulesync install` from the pinned
# sources in rulesync.jsonc. rulesync.lock (committed) holds the resolved
# commits and per-skill integrity hashes; the copies themselves are cache.
.rulesync/skills/.curated/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vale package output (`vale sync`). Keep the project vocabulary, which is the
# one part of styles/ this repository writes.
styles/*
!styles/config/
styles/config/*
!styles/config/vocabularies/
!styles/config/vocabularies/**/

# Local env and secrets. Never belongs in a public template.
.env
.env.*
!.env.example

# Agent state that can hold credentials or is per-clone.
.claude/settings.local.json
.claude/.credentials.json

# OS cruft
.DS_Store
._*
Thumbs.db
Desktop.ini

# Editors
.idea/
*.swp
*.swo
*~

# Local artifacts
*.tmp
*.log
