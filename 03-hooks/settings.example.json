{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/03-hooks/deny-unsafe-delete.py"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/03-hooks/deny-secret-in-write.py"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/03-hooks/require-plan-before-edit.py", "--gate"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "TodoWrite|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/03-hooks/require-plan-before-edit.py", "--record"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
