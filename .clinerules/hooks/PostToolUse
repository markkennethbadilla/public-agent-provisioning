#!/bin/bash
# PostToolUse hook generated by rulesync — edit .rulesync/hooks.jsonc and regenerate.
# rulesync-owned: cline-hooks

case "${OSTYPE:-$(uname -s 2>/dev/null || true)}" in
  msys*|MSYS*|cygwin*|CYGWIN*|MINGW*|mingw*)
    printf '{"cancel": false, "contextModification": "", "errorMessage": ""}\n'
    exit 0
    ;;
esac

payload=$(cat)
cancel=false
error_message=''

if [ "$cancel" = false ]; then
  if bash -n -c 'if [ -f task_plan.md ] || [ -f .planning/.active_plan ] || ls .planning/*/task_plan.md >/dev/null 2>&1; then echo '\''[planning-with-files] Update progress.md with what you just did. If a phase is now complete, update task_plan.md status.'\''; fi' 2>/dev/null; then
    hook_stderr=$(printf '%s' "$payload" | bash -c 'if [ -f task_plan.md ] || [ -f .planning/.active_plan ] || ls .planning/*/task_plan.md >/dev/null 2>&1; then echo '\''[planning-with-files] Update progress.md with what you just did. If a phase is now complete, update task_plan.md status.'\''; fi' 2>&1 >/dev/null)
    hook_status=$?
    if [ "$hook_status" -eq 2 ]; then
      cancel=true
      error_message="$hook_stderr"
    elif [ "$hook_status" -ne 0 ]; then
      printf '%s\n' "rulesync PostToolUse hook failed (exit $hook_status): $hook_stderr" >&2
      error_message="$hook_stderr"
    fi
  else
    error_message="rulesync PostToolUse hook command is not valid shell syntax"
    printf '%s\n' "$error_message" >&2
  fi
fi

escape_json() {
  printf '%s' "$1" | tr '\n\r\t' '   ' | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

printf '{"cancel": %s, "contextModification": "", "errorMessage": "%s"}\n' "$cancel" "$(escape_json "$error_message")"
